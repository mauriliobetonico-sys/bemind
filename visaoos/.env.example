# ══════════════════════════════════════════════════════
# VISÃOOS — Configuração do Ambiente
# Copie para .env e preencha com seus dados reais
# ══════════════════════════════════════════════════════

# ── Banco de Dados MySQL ──────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=visaoos
DB_USER=visaoos_user
DB_PASS=SENHA_FORTE_AQUI

# ── URL da Aplicação (sem barra no final) ─────────────
APP_URL=https://seusite.com.br

# ── JWT ──────────────────────────────────────────────
# Gere com: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=TROQUE_POR_STRING_ALEATORIA_LONGA_AQUI
JWT_EXPIRES=86400

# ── n8n (Automação de Workflows) ─────────────────────
N8N_WEBHOOK_BASE=http://localhost:5678/webhook
N8N_API_KEY=

# ── Nextcloud (Armazenamento de Arquivos) ─────────────
NEXTCLOUD_URL=http://localhost:8080
NEXTCLOUD_USER=admin
NEXTCLOUD_PASS=
NEXTCLOUD_FOLDER=/VisaoOS/uploads

# ── E-mail SMTP ──────────────────────────────────────
SMTP_HOST=smtp.seuprovedor.com.br
SMTP_PORT=587
SMTP_USER=noreply@seusite.com.br
SMTP_PASS=
SMTP_FROM_NAME=VisãoOS

# ── Mercado Pago (Pagamentos) ─────────────────────────
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ── WebSocket Server ──────────────────────────────────
WS_PORT=6001
WS_SECRET=MESMO_JWT_SECRET_AQUI
