# ══════════════════════════════════════════════════════
# EU RESOLVO — Configuração do Ambiente
# Copie para .env e preencha com valores reais.
# ══════════════════════════════════════════════════════

# ── Aplicação ─────────────────────────────────────────
APP_NAME=EU RESOLVO
APP_ENV=production
APP_URL=https://euresolvo.com.br

# ── Banco de Dados MySQL/MariaDB ──────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=euresolvo
DB_USER=euresolvo_user
DB_PASS=SENHA_FORTE_AQUI

# ── Admin Bootstrap (só no primeiro deploy) ───────────
ADMIN_EMAIL=admin@euresolvo.com.br
ADMIN_PASSWORD=troque_no_primeiro_login

# ── JWT ───────────────────────────────────────────────
# Gere com: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=TROQUE_POR_STRING_ALEATORIA_LONGA_AQUI
JWT_EXPIRES=86400
JWT_REFRESH_EXPIRES=2592000

# ── Upload ────────────────────────────────────────────
UPLOAD_MAX_MB=20

# ── Mercado Pago ──────────────────────────────────────
# Comece em sandbox: https://www.mercadopago.com.br/developers
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
MP_MARKETPLACE_FEE=20

# ── Stripe (opcional) ─────────────────────────────────
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ── Regras de negócio ─────────────────────────────────
DEFAULT_COMMISSION_PCT=20
OFFER_TTL_SECONDS=180
DEFAULT_SEARCH_RADIUS_KM=25

# Pesos do algoritmo de match (soma total = 100 recomendado)
W_DISTANCE=30
W_SPECIALTY=20
W_RATING=15
W_ACCEPTANCE=10
W_CANCEL_RATE=10
W_LEVEL=10
W_REQUIREMENTS=5

# ── Mapa (OpenStreetMap grátis; ou Google/Mapbox) ─────
MAPS_PROVIDER=openstreetmap
MAPS_API_KEY=

# ── SMTP ──────────────────────────────────────────────
SMTP_HOST=smtp.seuprovedor.com.br
SMTP_PORT=587
SMTP_USER=noreply@euresolvo.com.br
SMTP_PASS=
SMTP_FROM_NAME=EU RESOLVO
SMTP_FROM_ADDR=noreply@euresolvo.com.br

# ── WebSocket ─────────────────────────────────────────
WS_URL=wss://euresolvo.com.br/ws
WS_HTTP=http://127.0.0.1:6001
WS_SECRET=USE_O_MESMO_JWT_SECRET

# ── n8n (Automação, opcional) ─────────────────────────
N8N_WEBHOOK_BASE=http://localhost:5678/webhook
N8N_API_KEY=
