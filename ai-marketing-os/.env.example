# =====================================================================
# AI Marketing OS — variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env.
# Descrição completa de cada variável: docs/ENVIRONMENT.md
# Gerar segredos:  openssl rand -hex 24   (hex: seguro dentro das URLs de conexão)
# Teste local rápido: ./scripts/setup-local-env.sh gera este arquivo pronto
# =====================================================================

# --- Geral -----------------------------------------------------------
NODE_ENV=production                 # development | staging | production
DOMAIN=app.suaagencia.com.br        # domínio público (Caddy emite o TLS)
ACME_EMAIL=voce@suaagencia.com.br   # contato para o Let's Encrypt
APP_URL=https://app.suaagencia.com.br
APP_SECRET=                         # obrigatório: openssl rand -hex 32 (assina os links de proposta)
LOG_LEVEL=info
IMAGE_TAG=latest

# --- Banco de dados --------------------------------------------------
POSTGRES_DB=aimos
POSTGRES_USER=aimos_owner           # dono do schema: usado só pelas migrations e backups
POSTGRES_PASSWORD=                  # obrigatório
APP_DB_PASSWORD=                    # obrigatório (mín. 16): role aimos_app, sujeito a RLS

# --- Redis -----------------------------------------------------------
REDIS_PASSWORD=                     # obrigatório

# --- Sessões e segurança --------------------------------------------
COOKIE_SECURE=true                  # false somente em desenvolvimento sem HTTPS
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
INVITE_TTL_HOURS=72
RESET_TTL_MINUTES=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
AUTH_RATE_PER_MINUTE=10
RATE_LIMIT_PER_MINUTE=300

# --- E-mail (SMTP) ---------------------------------------------------
# Sem SMTP_HOST os convites ficam no outbox e o painel mostra "integration_pending".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=AI Marketing OS <no-reply@suaagencia.com.br>
SUPPORT_EMAIL=suporte@suaagencia.com.br

# --- Arquivos e antivírus -------------------------------------------
MAX_UPLOAD_MB=200                   # limite por arquivo (até 20 por envio)
CLAMAV_HOST=                        # "clamav" com: docker compose --profile antivirus up -d
CLAMAV_PORT=3310

# --- Inteligência artificial (somente servidor) ----------------------
# Sem ANTHROPIC_API_KEY os agentes ficam em "integration_pending" (nada é simulado).
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=             # só se a chave for da organização (erro "not scoped to a workspace")
AI_MODEL=claude-opus-5-5            # modelo dos agentes
AI_SERVER_FALLBACK=true             # se o modelo recusar por política, a Anthropic refaz em outro modelo (beta)
# Opcional: OpenAI SOMENTE para embeddings (busca semântica na memória dos clientes)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- Integrações (MCP Hub) -------------------------------------------
# Cifra as credenciais das integrações (WordPress, webhooks). Gere com: openssl rand -hex 32
# Guarde uma cópia segura: sem ela, as credenciais salvas não podem ser lidas (é só reconectar).
CREDENTIALS_KEY=
MCP_ALLOW_PRIVATE_HOSTS=false       # true só se uma integração estiver na sua rede interna (ex.: n8n local)

# --- Automação (relatório diário e lembretes) ------------------------
APP_TIMEZONE=America/Sao_Paulo      # fuso da agência: define "hoje" e os horários abaixo
DAILY_REPORT_HOUR=18                # relatório do dia de cada cliente (e-mail + portal)
REMINDERS_HOUR=8                    # prazos, tarefas atrasadas e aprovações paradas

# --- Backup ----------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
