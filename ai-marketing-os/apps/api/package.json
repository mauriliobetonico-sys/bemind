{
  "name": "@aimos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsup",
    "start": "node dist/server.mjs",
    "start:worker": "node dist/worker.mjs",
    "migrate": "tsx src/db/migrate-cli.ts",
    "migrate:prod": "node dist/db/migrate-cli.mjs",
    "seed:admin": "tsx src/db/seed-admin-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aimos/shared": "workspace:*",
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^10.3.0",
    "@node-rs/argon2": "^2.0.2",
    "fastify": "^5.6.0",
    "fastify-plugin": "^6.0.0",
    "file-type": "^22.1.1",
    "ioredis": "^5.7.0",
    "nodemailer": "^7.0.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.15.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
