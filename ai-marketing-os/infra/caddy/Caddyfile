{
	# Certificados TLS automáticos (Let's Encrypt) para o domínio público.
	email {$ACME_EMAIL:admin@localhost}
}

{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Uploads têm limite próprio (a API também valida por arquivo: MAX_UPLOAD_MB).
	@uploads path /api/files /api/files/*
	request_body @uploads {
		max_size 4200MB
	}
	@other not path /api/files /api/files/*
	request_body @other {
		max_size 2MB
	}

	handle /api/* {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format json
	}
}
