{
  "name": "VisãoOS — Relatório Diário Financeiro",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 24, "triggerAtHour": 8 }] }
      },
      "id": "cron-trigger",
      "name": "Todo dia às 8h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.APP_URL }}/api/finance/summary",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "Bearer {{ $env.VISAOOS_API_TOKEN }}" }]
        },
        "options": {}
      },
      "id": "get-summary",
      "name": "Busca Resumo Financeiro",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.APP_URL }}/api/os?status=aguardando&limit=100",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "Bearer {{ $env.VISAOOS_API_TOKEN }}" }]
        },
        "options": {}
      },
      "id": "get-pending-os",
      "name": "Busca OS Aguardando",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.SMTP_FROM }}",
        "toEmail": "={{ $env.ADMIN_EMAIL }}",
        "subject": "=VisãoOS — Relatório Diário {{ $now.format('dd/MM/yyyy') }}",
        "emailType": "html",
        "message": "=<html><body style=\"font-family:Arial;background:#f5f6fa;padding:20px\">\n<div style=\"max-width:600px;margin:0 auto;background:#fff;border-radius:12px;padding:24px\">\n  <div style=\"background:#3b5bdb;color:#fff;padding:14px;border-radius:8px;margin-bottom:18px\">\n    <h1 style=\"margin:0;font-size:18px\">VisãoOS — Relatório Diário</h1>\n    <div style=\"opacity:.8;font-size:12px\">{{ $now.format('dd/MM/yyyy') }}</div>\n  </div>\n  <div style=\"display:flex;gap:12px;margin-bottom:18px\">\n    <div style=\"flex:1;background:#eef1ff;border-radius:8px;padding:12px;text-align:center\">\n      <div style=\"font-size:10px;color:#9299b5;text-transform:uppercase\">Faturamento Mês</div>\n      <div style=\"font-size:22px;font-weight:800;color:#3b5bdb\">R$ {{ $('Busca Resumo Financeiro').item.json.month_revenue.toFixed(2).replace('.', ',') }}</div>\n    </div>\n    <div style=\"flex:1;background:#fff4ee;border-radius:8px;padding:12px;text-align:center\">\n      <div style=\"font-size:10px;color:#9299b5;text-transform:uppercase\">A Receber</div>\n      <div style=\"font-size:22px;font-weight:800;color:#e67700\">R$ {{ $('Busca Resumo Financeiro').item.json.total_pending.toFixed(2).replace('.', ',') }}</div>\n    </div>\n    <div style=\"flex:1;background:#ebfbee;border-radius:8px;padding:12px;text-align:center\">\n      <div style=\"font-size:10px;color:#9299b5;text-transform:uppercase\">OS Aguardando</div>\n      <div style=\"font-size:22px;font-weight:800;color:#087f5b\">{{ $('Busca OS Aguardando').item.json.total }}</div>\n    </div>\n  </div>\n  {{ $('Busca Resumo Financeiro').item.json.overdue_count > 0 ? '<div style=\"background:#fff5f5;border:1.5px solid #c92a2a;border-radius:8px;padding:12px;margin-bottom:14px\"><strong style=\"color:#c92a2a\">⚠️ Atenção: ' + $('Busca Resumo Financeiro').item.json.overdue_count + ' OS com pagamento em atraso!</strong></div>' : '' }}\n  <a href=\"{{ $env.APP_URL }}\" style=\"display:inline-block;background:#3b5bdb;color:#fff;text-decoration:none;padding:10px 20px;border-radius:8px;font-weight:600\">Acessar VisãoOS</a>\n</div></body></html>",
        "options": {}
      },
      "id": "send-daily-report",
      "name": "Enviar Relatório",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Todo dia às 8h": { "main": [[{ "node": "Busca Resumo Financeiro", "type": "main", "index": 0 }]] },
    "Busca Resumo Financeiro": { "main": [[{ "node": "Busca OS Aguardando", "type": "main", "index": 0 }]] },
    "Busca OS Aguardando": { "main": [[{ "node": "Enviar Relatório", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "visaoos" }, { "name": "relatorios" }]
}
