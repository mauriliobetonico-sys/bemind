# ─── Banco de Dados ──────────────────────────────────────────────────────────
POSTGRES_DB=viscom
POSTGRES_USER=viscom
POSTGRES_PASSWORD=troque_por_senha_forte

# ─── API / JWT ────────────────────────────────────────────────────────────────
# Gere com: openssl rand -hex 32
SECRET_KEY=troque_por_chave_secreta_de_32_bytes_hex
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Dados da Empresa ─────────────────────────────────────────────────────────
COMPANY_NAME=VisCom Comunicação Visual Ltda.
COMPANY_CNPJ=00.000.000/0001-00
COMPANY_ADDRESS=Rua das Placas, 123 - Centro - São Paulo/SP - CEP 01000-000
COMPANY_PHONE=(11) 3333-4444
COMPANY_EMAIL=contato@viscom.com.br
LOGO_PATH=/app/static/logo.png

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=/api

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost,http://localhost:80

# ─── Portas ───────────────────────────────────────────────────────────────────
HTTP_PORT=80
